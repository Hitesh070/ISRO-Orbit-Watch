# OrbitGuard Environment Configuration Template
# ===============================================
# Copy this file to .env for local development or configure in Vercel / GitHub Secrets.
# NEVER commit real credentials to version control.

# --- Backend & Pipeline Configuration ---
PORT=8000
ENVIRONMENT=production
DATA_REFRESH_HOURS=6
CORS_ORIGINS=https://orbit-guard-tan.vercel.app,http://localhost:5173,http://localhost:3000

# --- Optional Space-Track.org Credentials ---
# Required only if running full 25,000+ object catalog pipeline mode from Space-Track.
# If omitted, OrbitGuard uses CelesTrak's open CCSDS OMM/GP API without credentials.
SPACETRACK_USER=
SPACETRACK_PASS=

# --- Frontend Client Configuration ---
VITE_API_URL=

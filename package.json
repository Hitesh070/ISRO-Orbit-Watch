{
  "name": "isro-orbit-watch",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop tracking of public orbital elements for Indian spacecraft",
  "author": "ISRO Orbit Watch contributors",
  "main": "desktop/main.cjs",
  "scripts": {
    "install:app": "npm --prefix frontend install",
    "build:web": "npm --prefix frontend run build",
    "check:orbit": "node scripts/orbit_smoke.mjs",
    "start": "npm run build:web && electron .",
    "dist:win": "npm run build:web && electron-builder --win portable",
    "dev:web": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12"
  },
  "overrides": { "minimatch": "^11.0.5" },
  "build": {
    "appId": "org.india.orbitwatch",
    "productName": "ISRO Orbit Watch",
    "directories": { "output": "release" },
    "files": ["desktop/main.cjs", "frontend/dist/**/*"],
    "win": { "icon": "resources/icon.ico", "target": ["portable"] }
  }
}
